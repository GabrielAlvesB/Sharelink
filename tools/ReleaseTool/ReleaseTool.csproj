<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ferramenta de quem publica o Sharelink: chaves de assinatura, assinatura do instalador e ícone. Não vai para o instalador. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharelink\Sharelink.csproj" />
  </ItemGroup>

</Project>
