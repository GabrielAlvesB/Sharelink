<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sharelink: captura de tela pessoal e segura.
    Regra de segurança: este projeto NÃO tem PackageReference. Tudo vem do .NET e da API do Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <RootNamespace>Sharelink</RootNamespace>
    <AssemblyName>Sharelink</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Sharelink</Product>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- O .ico é gerado pelo próprio código do app (tools/ReleaseTool icon). -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\assets\Sharelink.ico')">
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\Sharelink.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharelink.Tests" />
    <InternalsVisibleTo Include="ReleaseTool" />
    <!-- Rede só onde é declarada explicitamente (Upload/Providers e Update/GitHubUpdateClient.cs). -->
    <Using Remove="System.Net.Http" />
  </ItemGroup>

</Project>
